{
  "permissions": {
    "deny": [
      "mcp__{{MCP_SERVER}}__createConfluencePage",
      "mcp__{{MCP_SERVER}}__updateConfluencePage",
      "mcp__{{MCP_SERVER}}__createConfluenceFooterComment",
      "mcp__{{MCP_SERVER}}__createConfluenceInlineComment",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.dev.vars)"
    ],
    "allow": [
      "mcp__{{MCP_SERVER}}__createJiraIssue",
      "mcp__{{MCP_SERVER}}__editJiraIssue",
      "mcp__{{MCP_SERVER}}__transitionJiraIssue",
      "mcp__{{MCP_SERVER}}__addCommentToJiraIssue"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler d1 migrations apply:*)",
      "Bash(gh api:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh secret:*)"
    ]
  }
}
